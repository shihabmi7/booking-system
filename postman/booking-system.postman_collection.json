              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"2026-09-15\",\n  \"reason\": \"Duplicate attempt\"\n}"
            },
            "description": "Same date as 'Add Holiday' above. The @@unique([businessId, date]) constraint should reject this with 409."
          },
          "event": [
