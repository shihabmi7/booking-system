{
  "info": {
    "name": "Booking System API",
    "description": "Phase 1-5 endpoints for the appointment booking system. Requests are chained with collection variables via test scripts, so running them top to bottom in a folder auto-fills the next request's IDs. Run '0. Auth' first to get adminToken/staffToken, then 'List Services' before anything else, and 'List Available Slots' before creating a booking.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "adminEmail", "value": "admin@sunriseclinic.test" },
    { "key": "adminPassword", "value": "AdminPass123!" },
    { "key": "staffEmail", "value": "staff@sunriseclinic.test" },
    { "key": "staffPassword", "value": "StaffPass123!" },
    { "key": "adminToken", "value": "" },
    { "key": "staffToken", "value": "" },
    { "key": "newStaffEmail", "value": "" },
    { "key": "newServiceId", "value": "" },
    { "key": "newResourceId", "value": "" },
    { "key": "resourceId", "value": "" },
    { "key": "serviceId", "value": "" },
    { "key": "date", "value": "2026-08-25" },
    { "key": "startTime", "value": "" },
    { "key": "bookingRef", "value": "" },
    { "key": "retryKey", "value": "demo-retry-key-001" },
    { "key": "businessId", "value": "" },
    { "key": "holidayId", "value": "" },
    { "key": "closedWeekdayDate", "value": "2026-08-28" },
    { "key": "holidayDate", "value": "2026-08-29" },
    { "key": "checkinBookingRef", "value": "" },
    { "key": "checkinStartTime", "value": "" },
    { "key": "noShowBookingRef", "value": "" },
    { "key": "noShowStartTime", "value": "" }
  ],
  "item": [
    {
      "name": "0. Auth",
      "item": [
        {
          "name": "Login as Admin",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "description": "Credentials come from the seed script (prisma/seed.ts) — run 'npm run seed' on the backend first. Auto-saves the JWT as adminToken for every request below that needs ADMIN access."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Response includes a token', () => pm.expect(body.token).to.be.a('string'));",
                  "pm.test('Role is ADMIN', () => pm.expect(body.user.role).to.eql('ADMIN'));",
                  "pm.collectionVariables.set('adminToken', body.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as Staff",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{staffEmail}}\",\n  \"password\": \"{{staffPassword}}\"\n}"
            },
            "description": "Auto-saves the JWT as staffToken — used to prove STAFF-level endpoints work, and that ADMIN-only endpoints correctly reject a STAFF token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Role is STAFF', () => pm.expect(body.user.role).to.eql('STAFF'));",
                  "pm.collectionVariables.set('staffToken', body.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login with Wrong Password (expect 401)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"WrongPassword!\"\n}"
            },
            "description": "Same error as a nonexistent email would give — proves the API doesn't leak which emails have accounts."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status is 401 Unauthorized', () => pm.response.to.have.status(401));"]
              }
            }
          ]
        },
        {
          "name": "Get Current User (Me)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "description": "Lets the frontend verify a stored token is still valid and fetch the current user's role."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Email matches', () => pm.expect(pm.response.json().email).to.eql(pm.collectionVariables.get('adminEmail')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create New Staff Account (Admin only)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/users",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"postman-staff-{{$timestamp}}@sunriseclinic.test\",\n  \"password\": \"NewStaffPass123!\",\n  \"role\": \"STAFF\"\n}"
            },
            "description": "Only an ADMIN token can create accounts. Uses {{$timestamp}} in the email so re-running this doesn't collide with a previous run's account. Auto-saves the created email as newStaffEmail."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Role is STAFF', () => pm.expect(body.role).to.eql('STAFF'));",
                  "pm.collectionVariables.set('newStaffEmail', body.email);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create New Staff as Non-Admin (expect 403)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/users",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{staffToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"should-not-be-created@sunriseclinic.test\",\n  \"password\": \"whatever123\",\n  \"role\": \"STAFF\"\n}"
            },
            "description": "Same endpoint, but with a STAFF token instead of ADMIN. requireRole(ADMIN) should reject this with 403 — a valid, logged-in user, just not an authorized one for this action."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status is 403 Forbidden', () => pm.response.to.have.status(403));"]
              }
            }
          ]
        },
        {
          "name": "List Users (Admin only)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/users",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "description": "Should include the seeded admin/staff accounts plus the one just created above."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const users = pm.response.json();",
                  "pm.test('Includes the newly created staff account', () => pm.expect(users.some(u => u.email === pm.collectionVariables.get('newStaffEmail'))).to.be.true);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Health & Services",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('dbConnected is true', () => pm.expect(pm.response.json().dbConnected).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "List Services",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/services",
            "description": "Public — no token needed. Auto-saves the first service's id/resourceId as collection variables for the requests below."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const services = pm.response.json();",
                  "pm.test('Has at least one seeded service', () => pm.expect(services.length).to.be.above(0));",
                  "if (services.length > 0) {",
                  "  pm.collectionVariables.set('serviceId', services[0].id);",
                  "  pm.collectionVariables.set('resourceId', services[0].resourceId);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List Resources without Token (expect 401)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/resources",
            "description": "As of Phase 5, this endpoint requires login. No Authorization header here on purpose — proves requireAuth actually rejects unauthenticated requests."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status is 401 Unauthorized', () => pm.response.to.have.status(401));"]
              }
            }
          ]
        },
        {
          "name": "List Resources",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/resources",
            "header": [{ "key": "Authorization", "value": "Bearer {{staffToken}}" }],
            "description": "Requires STAFF or ADMIN login — using staffToken here to prove STAFF-level read access works. Auto-saves the first resource's businessId — needed for the Holidays & Hours folder below."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const resources = pm.response.json();",
                  "pm.test('Has at least one resource', () => pm.expect(resources.length).to.be.above(0));",
                  "if (resources.length > 0) {",
                  "  pm.collectionVariables.set('businessId', resources[0].businessId);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Add Resource (Admin)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/resources",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Test Resource\"\n}"
            },
            "description": "ADMIN only. Creates a new resource under the admin's own business — businessId comes from the token, never the body. Omitted working hours fall back to the schema's own defaults (09:00-17:00, no closed days). Auto-saves the created id as newResourceId."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const resource = pm.response.json();",
                  "pm.test('Defaults applied', () => pm.expect(resource.workingHoursStart).to.eql('09:00'));",
                  "pm.collectionVariables.set('newResourceId', resource.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Add Resource as Staff (expect 403)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/resources",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{staffToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Should be rejected\"\n}"
            },
            "description": "Same endpoint, STAFF token instead of ADMIN — creating a resource is ADMIN-only, same as services and holidays."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status is 403 Forbidden', () => pm.response.to.have.status(403));"]
              }
            }
          ]
        },
        {
          "name": "Add Service (Admin)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/services",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resourceId\": \"{{resourceId}}\",\n  \"name\": \"Postman Test Service\",\n  \"durationMins\": 10,\n  \"price\": 250\n}"
            },
            "description": "ADMIN only. Attaches a new service to one of the admin's own resources — resourceId must belong to the admin's business, or this returns 403. Auto-saves the created service's id as newServiceId."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('newServiceId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Add Service as Staff (expect 403)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/services",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{staffToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resourceId\": \"{{resourceId}}\",\n  \"name\": \"Should be rejected\",\n  \"durationMins\": 10,\n  \"price\": 100\n}"
            },
            "description": "Same endpoint, STAFF token instead of ADMIN — managing the service catalog is ADMIN-only, same as holidays and resource hours."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status is 403 Forbidden', () => pm.response.to.have.status(403));"]
              }
            }
          ]
        },
        {
          "name": "Update Service (Admin)",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/services/{{newServiceId}}",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 275\n}"
            },
            "description": "ADMIN only. Only fields included in the body are changed — this updates just the price of the service created above."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Price updated', () => pm.expect(pm.response.json().price).to.eql('275'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete Service (Admin)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/services/{{newServiceId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "description": "ADMIN only. Cleans up the service created by 'Add Service (Admin)' — succeeds because it has no bookings against it. Deleting a service that already has bookings would instead return 409 (see services.ts's P2003 handling)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status is 204', () => pm.response.to.have.status(204));"]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Booking Flow",
      "item": [
        {
          "name": "List Available Slots",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/slots?resourceId={{resourceId}}&serviceId={{serviceId}}&date={{date}}",
            "description": "Public — no token needed (customer-facing). Uses resourceId/serviceId from 'List Services'. Change the 'date' collection variable if you want a different day. Response is {slots, note}. Auto-saves the first open slot's startTime."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Response has a slots array', () => pm.expect(body).to.have.property('slots'));",
                  "if (body.slots.length > 0) {",
                  "  pm.collectionVariables.set('startTime', body.slots[0].startTime);",
                  "} else if (body.note) {",
                  "  console.log('No slots — closed:', body.note);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Booking",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/bookings",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resourceId\": \"{{resourceId}}\",\n  \"serviceId\": \"{{serviceId}}\",\n  \"startTime\": \"{{startTime}}\",\n  \"customerName\": \"Postman Test Patient\",\n  \"customerPhone\": \"+8801000000000\",\n  \"idempotencyKey\": \"{{$guid}}\"\n}"
            },
            "description": "Public — no token needed (customers book without an account). Books the slot found by 'List Available Slots'. Auto-saves the returned bookingRef."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const booking = pm.response.json();",
                  "pm.collectionVariables.set('bookingRef', booking.bookingRef);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Booking by Ref",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/bookings/{{bookingRef}}",
            "description": "Public lookup by the customer-facing booking reference — no login needed, possession of the reference is the 'auth' here."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Booking status is BOOKED', () => pm.expect(pm.response.json().status).to.eql('BOOKED'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Concurrency & Idempotency Tests",
      "item": [
        {
          "name": "Double-Booking Attempt (expect 409)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/bookings",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resourceId\": \"{{resourceId}}\",\n  \"serviceId\": \"{{serviceId}}\",\n  \"startTime\": \"{{startTime}}\",\n  \"customerName\": \"Second Patient (should be rejected)\",\n  \"idempotencyKey\": \"{{$guid}}\"\n}"
            },
            "description": "Run this right after 'Create Booking' WITHOUT re-running 'List Available Slots' — it reuses the same startTime that's already booked, with a different (fresh) idempotencyKey. Should fail with 409, proving the @@unique([resourceId, startTime]) constraint works."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 409 Conflict', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Idempotent Retry - First Call",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/bookings",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resourceId\": \"{{resourceId}}\",\n  \"serviceId\": \"{{serviceId}}\",\n  \"startTime\": \"{{startTime}}\",\n  \"customerName\": \"Retry Test Patient\",\n  \"idempotencyKey\": \"{{retryKey}}\"\n}"
            },
            "description": "Run 'List Available Slots' again first to get a fresh, unbooked startTime, THEN run this request. Uses the fixed 'retryKey' collection variable instead of a random guid."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 (first time creating)', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('bookingRef', pm.response.json().bookingRef);"
                ]
              }
            }
          ]
        },
        {
          "name": "Idempotent Retry - Second Call (same key)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/bookings",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resourceId\": \"{{resourceId}}\",\n  \"serviceId\": \"{{serviceId}}\",\n  \"startTime\": \"{{startTime}}\",\n  \"customerName\": \"Retry Test Patient\",\n  \"idempotencyKey\": \"{{retryKey}}\"\n}"
            },
            "description": "Identical body to 'Idempotent Retry - First Call', including the same idempotencyKey. Should return 200 with the SAME bookingRef instead of creating a duplicate or erroring."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 (returned existing booking)', () => pm.response.to.have.status(200));",
                  "pm.test('Same bookingRef as first call', () => pm.expect(pm.response.json().bookingRef).to.eql(pm.collectionVariables.get('bookingRef')));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Holidays & Hours",
      "item": [
        {
          "name": "Slots on a Weekly-Closed Day (expect empty + note)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/slots?resourceId={{resourceId}}&serviceId={{serviceId}}&date={{closedWeekdayDate}}",
            "description": "Public. The seeded resource has closedWeekdays: [5] (Friday), and closedWeekdayDate defaults to a Friday. Should return an empty slots array plus a note explaining the weekly closure."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('No open slots', () => pm.expect(body.slots.length).to.eql(0));",
                  "pm.test('Has a closure note', () => pm.expect(body.note).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Slots on the Seeded Holiday (expect empty + note)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/slots?resourceId={{resourceId}}&serviceId={{serviceId}}&date={{holidayDate}}",
            "description": "Public. holidayDate defaults to the seed script's 'Staff Training Day' holiday. Should return an empty slots array plus a note with the holiday reason."
          },
          "event": [
            {
              "listen": "test",
