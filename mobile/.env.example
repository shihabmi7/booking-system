# Copy to .env for local development. .env is gitignored (root .gitignore), this file is not.
#
# Leave EXPO_PUBLIC_API_BASE_URL unset and src/api/config.ts picks the right localhost for the
# platform automatically: http://10.0.2.2:4000 on an Android emulator (which cannot reach the
# host as "localhost"), http://localhost:4000 on an iOS simulator.
#
# Set it explicitly only when the default can't work — most commonly a PHYSICAL phone, which
# needs your dev machine's LAN address (find it with `ipconfig getifaddr en0`):
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.50:4000
