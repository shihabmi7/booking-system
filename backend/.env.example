PORT=4000
DATABASE_URL=postgresql://booking_user:booking_pass@localhost:5432/booking_db

# Secret used to sign/verify JWTs. Use a long random string in real deployments —
# this dev default is fine for local testing only, never reuse it anywhere real.
JWT_SECRET=dev-only-secret-change-me
JWT_EXPIRES_IN=8h

# --- Push notifications (Firebase Cloud Messaging) ---
# From the service-account JSON you download at Firebase Console → Project Settings →
# Service accounts → "Generate new private key". FCM delivers to Android AND iOS; for iOS you
# additionally upload an APNs .p8 auth key under Project Settings → Cloud Messaging.
#
# Leave these unset for local development: services/push.ts falls back to a console driver,
# so notifications are still stored and returned by the API — nothing else breaks.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the whole private_key value INCLUDING the literal \n sequences, wrapped in quotes.
# A dotenv value can't contain real newlines; services/push.ts converts \n back before use.
FIREBASE_PRIVATE_KEY=""

# Set to "false" to run this instance without the reminder cron (see jobs/reminderScheduler.ts)
REMINDERS_ENABLED=true
