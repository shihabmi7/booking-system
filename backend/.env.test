# Loaded by tests/setup.ts BEFORE anything imports db/prisma.ts, so the test run never
# touches the dev database — a separate physical database (booking_db_test), not just a
# different schema, so a bad TRUNCATE in test cleanup can't ever reach real dev data.
PORT=4001
DATABASE_URL=postgresql://booking_user:booking_pass@localhost:5432/booking_db_test

JWT_SECRET=test-only-secret
JWT_EXPIRES_IN=8h

# Never let a test run start the real cron loop — resetDb() between tests would otherwise
# race against a sweep tick reading/writing the same tables mid-test.
REMINDERS_ENABLED=false

# Firebase stays unset here on purpose — push.ts's console-mode fallback is exactly what
# tests want (see services/push.ts), so notify() is fully exercised without a real project.
