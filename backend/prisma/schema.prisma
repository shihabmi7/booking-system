generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A single clinic/salon/dentist office. Phase 1 MVP scope = one Business, but the
// schema supports many, since that's the natural shape for later phases.
model Business {
  id        String     @id @default(uuid())
  name      String
  timezone  String     @default("UTC")
  createdAt DateTime   @default(now())
  resources Resource[]
  // Holidays apply to the whole business (every resource) rather than per-resource —
  // most closures (public holidays, the clinic being shut) affect everyone at once.
  holidays  Holiday[]
  users     User[]
  // 1:1 — created lazily by services/notificationSettings.ts the first time settings are
  // read or written, so existing businesses don't need a backfill migration.
  notificationSetting NotificationSetting?
}

enum UserRole {
  STAFF
  ADMIN
}

// A staff or admin login — NOT a customer account (see Customer model below, added in the
// "customer accounts" phase). This table only exists for the people running the business.
// Staff and customers are deliberately two separate identity systems that happen to share
// infrastructure (JWT, bcrypt) — see services/auth.ts's `kind` field on the token payload.
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         UserRole
  businessId   String
  business     Business @relation(fields: [businessId], references: [id])
  createdAt    DateTime @default(now())
  // Notifications this staff member manually sent (system-generated ones have no sender).
  sentNotifications Notification[]
}

// A customer account — separate from User (staff/admin) entirely. Customers self-register,
// verify their email via a one-time code (see OtpCode below), and log in to book. `email` is
// the fixed, immutable identifier (never editable from the profile — see routes/customer.ts);
// `name`/`phone`/`profilePictureUrl` are the only fields a customer can change about themselves.
model Customer {
  id                String    @id @default(uuid())
  email             String    @unique
  passwordHash      String
  name              String
  phone             String?
  profilePictureUrl String?
  // null = email not verified yet. Login and booking creation both require this to be set —
  // enforced in routes/customer.ts and routes/bookings.ts respectively, not by the schema.
  emailVerifiedAt   DateTime?
  createdAt         DateTime  @default(now())
  bookings          Booking[]
  otpCodes          OtpCode[]
  devices           DeviceToken[]
  notifications     Notification[]
}

enum OtpPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

// A one-time code sent to a customer's email (currently just console.log'd — see
// services/otp.ts — until Phase 6 wires a real email provider). Used for both signup
// verification and password reset, distinguished by `purpose`.
model OtpCode {
  id         String     @id @default(uuid())
  customerId String
  customer   Customer   @relation(fields: [customerId], references: [id])
  purpose    OtpPurpose
  // Hashed with bcrypt, same approach as a password — the raw 6-digit code is never stored.
  // Low entropy (1,000,000 possibilities) is compensated by expiresAt + attempts below, not
  // by the hash alone, but there's no reason to store it in plaintext either.
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now())
}

// A doctor / stylist / dentist / chair — whatever the bookable "unit" is for a Business.
model Resource {
  id                String    @id @default(uuid())
  name              String
  businessId        String
  business          Business  @relation(fields: [businessId], references: [id])
  // Stored as "HH:MM" 24h strings — one fixed daily range, applied to every non-closed day.
  workingHoursStart String    @default("09:00")
  workingHoursEnd   String    @default("17:00")
  // Days of the week this resource never works, regardless of holidays.
  // 0 = Sunday ... 6 = Saturday (matches JS Date.getDay()).
  closedWeekdays    Int[]     @default([])
  services          Service[]
  bookings          Booking[]
  createdAt         DateTime  @default(now())
}

// A specific one-off closed date for a Business (public holiday, planned closure, etc) —
// distinct from closedWeekdays, which is a recurring weekly pattern.
model Holiday {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  date       DateTime @db.Date
  reason     String?
  createdAt  DateTime @default(now())

  @@unique([businessId, date])
}

// Something a Resource offers — has a duration (used later for slot generation) and a price.
model Service {
  id           String    @id @default(uuid())
  name         String
  durationMins Int
  price        Decimal   @db.Decimal(10, 2)
  resourceId   String
  resource     Resource  @relation(fields: [resourceId], references: [id])
  bookings     Booking[]
  createdAt    DateTime  @default(now())
}

enum BookingStatus {
  BOOKED
  CHECKED_IN
  COMPLETED
  NO_SHOW
  CANCELLED
}

// Note: no separate "Slot" table. Available slots are computed on demand (Phase 3)
// from a Resource's working hours minus existing Bookings, rather than pre-generated
// and stored — avoids stale/exploding data for recurring daily availability.
//
// Note: no separate "CheckIn" table either — checkedInAt/checkInMethod live directly
// on Booking since it's a 1:1 relationship. A separate table would be overkill for MVP.
model Booking {
  id            String        @id @default(uuid())
  // The public-facing ID customers use to check in via QR/booking-id — deliberately
  // separate from the internal `id` so it can be regenerated/rotated without changing
  // the primary key relationships.
  bookingRef    String        @unique @default(uuid())
  // Nullable — NOT a temporary migration shim. This stays valid indefinitely for two cases:
  // (1) bookings made before the customer-accounts phase existed, and (2) staff-created
  // walk-in bookings for someone with no account at all (see routes/staffBookings.ts).
  // Every self-service customer booking (routes/bookings.ts) always sets this.
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id])
  // Snapshotted at booking time from the Customer's profile (or typed by staff for a
  // walk-in) — deliberately NOT re-derived from the live Customer row on every read, so a
  // later profile name change doesn't rewrite history. Same reasoning e-commerce order
  // histories use for shipping names.
  customerName  String
  customerPhone String?
  customerEmail String?
  status        BookingStatus @default(BOOKED)
  startTime     DateTime
  endTime       DateTime
  resourceId    String
  resource      Resource      @relation(fields: [resourceId], references: [id])
  serviceId     String
  service       Service       @relation(fields: [serviceId], references: [id])
  checkedInAt   DateTime?
  checkInMethod String? // "qr" | "manual"
  // Optional client-supplied key for safe retries (e.g. a flaky network causing the same
  // "create booking" request to be sent twice) — a repeated key returns the original
  // booking instead of creating a duplicate.
  idempotencyKey String?      @unique
  createdAt     DateTime      @default(now())
  notifications Notification[]

  // Last line of defense against double-booking: even if two requests for the same
  // resource+startTime both pass the application-level availability check at the same
  // instant (a check-then-act race), only one INSERT can win here — the other fails
  // with a unique constraint violation, which the API turns into a clean 409 response.
  @@unique([resourceId, startTime])
}

// ---------------------------------------------------------------------------
// Notifications & push
// ---------------------------------------------------------------------------

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

// One row per (customer, device) — registered by the mobile app right after login, and
// refreshed whenever Firebase rotates the token (FCM does this on reinstall, restore to a new
// phone, or after long inactivity).
//
// `token` is the FCM registration token for BOTH platforms: on iOS the app calls
// Firebase's getToken(), and Firebase relays to APNs on the server side using the .p8 key
// uploaded to the Firebase console. That's why there's no separate APNs device-token column —
// see services/push.ts for the single-provider reasoning.
//
// `token` is globally unique rather than unique-per-customer on purpose: a token identifies a
// physical app install, so if two accounts log in on the same phone the newer registration
// must MOVE the token to the new customer, not create a second row. Otherwise the previous
// user's notifications keep landing on a device someone else is now using. See the upsert in
// routes/devices.ts.
model DeviceToken {
  id          String         @id @default(uuid())
  customerId  String
  customer    Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  token       String         @unique
  platform    DevicePlatform
  // Free-text, purely for support/debugging ("push isn't working on my iPhone") and for
  // deciding when an old client version needs a different payload shape.
  osVersion   String?
  appVersion  String?
  deviceModel String?
  // Bumped on every register call — lets a cleanup job prune tokens no app has touched in
  // months, which FCM would reject anyway.
  lastSeenAt  DateTime       @default(now())
  // Set when FCM reports the token as unregistered/invalid (app uninstalled). Kept rather
  // than deleted so delivery history in NotificationDelivery still resolves to a real row.
  disabledAt  DateTime?
  createdAt   DateTime       @default(now())
  deliveries  NotificationDelivery[]

  @@index([customerId, disabledAt])
}

enum NotificationType {
  BOOKING_CONFIRMED
  BOOKING_REMINDER
  CHECK_IN_CONFIRMED
  BOOKING_CANCELLED
  STAFF_MESSAGE
}

// The stored, in-app notification — the source of truth for the customer's notification
// list. Deliberately separate from NotificationDelivery below: a Notification exists even if
// the customer has no device registered at all (they'll still see it in the app next time
// they open it), and one Notification fans out to N device deliveries.
model Notification {
  id           String           @id @default(uuid())
  customerId   String
  customer     Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // Set for anything booking-related, so the app can deep-link straight to the booking.
  bookingId    String?
  booking      Booking?         @relation(fields: [bookingId], references: [id])
  type         NotificationType
  title        String
  body         String
  // Extra key/values forwarded to the client in the push payload's data section
  // (e.g. { bookingRef, screen: "BookingDetail" }) for deep-linking.
  data         Json?
  // Null for system-generated notifications; set to the staff/admin User who clicked send.
  sentByUserId String?
  sentByUser   User?            @relation(fields: [sentByUserId], references: [id])
  // The whole reason the reminder cron can be a dumb every-5-minutes poll: a key like
  // "<bookingId>:REMINDER:360" is unique, so a second attempt to insert the same reminder
  // fails at the database level instead of double-notifying. Null for anything that's
  // legitimately repeatable (a staff member sending two manual messages, say).
  dedupeKey    String?          @unique
  readAt       DateTime?
  createdAt    DateTime         @default(now())
  deliveries   NotificationDelivery[]

  // Serves the main list query (this customer's notifications, newest first) and the
  // unread-count query, both of which filter on customerId.
  @@index([customerId, createdAt])
}

enum DeliveryStatus {
  SENT
  FAILED
  SKIPPED
}

// One row per push attempt to one device. Exists so "the customer says they never got it" is
// answerable: which devices were targeted, what the provider said, and why a send was skipped.
model NotificationDelivery {
  id                String         @id @default(uuid())
  notificationId    String
  notification      Notification   @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  deviceTokenId     String
  deviceToken       DeviceToken    @relation(fields: [deviceTokenId], references: [id], onDelete: Cascade)
  status            DeliveryStatus
  // FCM's returned message name, e.g. "projects/x/messages/0:157...". Null on failure.
  providerMessageId String?
  error             String?
  attemptedAt       DateTime       @default(now())

  @@index([notificationId])
}

// Per-business notification settings — the "a setting will be fine" part of the reminder
// requirement. One row per Business, created on first read (see services/notificationSettings.ts).
model NotificationSetting {
  id         String   @id @default(uuid())
  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // How many MINUTES before a booking's startTime each reminder fires. Default [360, 60] =
  // the 6-hour and 1-hour reminders. An array rather than two boolean columns so a business
  // can add a 24h reminder (or drop to just one) without a schema change — the cron loops
  // over whatever is in here.
  reminderOffsetsMins Int[]  @default([360, 60])
  remindersEnabled    Boolean @default(true)
  checkInEnabled      Boolean @default(true)
  bookingConfirmedEnabled Boolean @default(true)
  // "HH:MM" in the Business's timezone. When set, non-urgent pushes inside this window are
  // still STORED (the customer sees them in-app) but no push is sent — see services/notifications.ts.
  quietHoursStart String?
  quietHoursEnd   String?
  updatedAt       DateTime @updatedAt
}
