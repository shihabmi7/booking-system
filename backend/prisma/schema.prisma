generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A single clinic/salon/dentist office. Phase 1 MVP scope = one Business, but the
// schema supports many, since that's the natural shape for later phases.
model Business {
  id        String     @id @default(uuid())
  name      String
  timezone  String     @default("UTC")
  createdAt DateTime   @default(now())
  resources Resource[]
  // Holidays apply to the whole business (every resource) rather than per-resource —
  // most closures (public holidays, the clinic being shut) affect everyone at once.
  holidays  Holiday[]
  users     User[]
}

enum UserRole {
  STAFF
  ADMIN
}

// A staff or admin login — NOT a customer account. Customers never authenticate; they prove
// ownership of a booking just by knowing its bookingRef (see Booking model). This table only
// exists for the people running the business.
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         UserRole
  businessId   String
  business     Business @relation(fields: [businessId], references: [id])
  createdAt    DateTime @default(now())
}

// A doctor / stylist / dentist / chair — whatever the bookable "unit" is for a Business.
model Resource {
  id                String    @id @default(uuid())
  name              String
  businessId        String
  business          Business  @relation(fields: [businessId], references: [id])
  // Stored as "HH:MM" 24h strings — one fixed daily range, applied to every non-closed day.
  workingHoursStart String    @default("09:00")
  workingHoursEnd   String    @default("17:00")
  // Days of the week this resource never works, regardless of holidays.
  // 0 = Sunday ... 6 = Saturday (matches JS Date.getDay()).
  closedWeekdays    Int[]     @default([])
  services          Service[]
  bookings          Booking[]
  createdAt         DateTime  @default(now())
}

// A specific one-off closed date for a Business (public holiday, planned closure, etc) —
// distinct from closedWeekdays, which is a recurring weekly pattern.
model Holiday {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  date       DateTime @db.Date
  reason     String?
  createdAt  DateTime @default(now())

  @@unique([businessId, date])
}

// Something a Resource offers — has a duration (used later for slot generation) and a price.
model Service {
  id           String    @id @default(uuid())
  name         String
  durationMins Int
  price        Decimal   @db.Decimal(10, 2)
  resourceId   String
  resource     Resource  @relation(fields: [resourceId], references: [id])
  bookings     Booking[]
  createdAt    DateTime  @default(now())
}

enum BookingStatus {
  BOOKED
  CHECKED_IN
  COMPLETED
  NO_SHOW
  CANCELLED
}

// Note: no separate "Slot" table. Available slots are computed on demand (Phase 3)
// from a Resource's working hours minus existing Bookings, rather than pre-generated
// and stored — avoids stale/exploding data for recurring daily availability.
//
// Note: no separate "CheckIn" table either — checkedInAt/checkInMethod live directly
// on Booking since it's a 1:1 relationship. A separate table would be overkill for MVP.
model Booking {
  id            String        @id @default(uuid())
  // The public-facing ID customers use to check in via QR/booking-id — deliberately
  // separate from the internal `id` so it can be regenerated/rotated without changing
  // the primary key relationships.
  bookingRef    String        @unique @default(uuid())
  customerName  String
  customerPhone String?
  customerEmail String?
  status        BookingStatus @default(BOOKED)
  startTime     DateTime
  endTime       DateTime
  resourceId    String
  resource      Resource      @relation(fields: [resourceId], references: [id])
  serviceId     String
  service       Service       @relation(fields: [serviceId], references: [id])
  checkedInAt   DateTime?
  checkInMethod String? // "qr" | "manual"
  // Optional client-supplied key for safe retries (e.g. a flaky network causing the same
  // "create booking" request to be sent twice) — a repeated key returns the original
  // booking instead of creating a duplicate.
  idempotencyKey String?      @unique
  createdAt     DateTime      @default(now())

  // Last line of defense against double-booking: even if two requests for the same
  // resource+startTime both pass the application-level availability check at the same
  // instant (a check-then-act race), only one INSERT can win here — the other fails
  // with a unique constraint violation, which the API turns into a clean 409 response.
  @@unique([resourceId, startTime])
}
